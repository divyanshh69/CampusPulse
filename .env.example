# CampusPulse - Environment Configuration Example
# Copy this file to .env and customize for your local setup

# Server Configuration (Use 5001 on macOS as port 5000 is reserved by AirPlay)
PORT=5001
NODE_ENV=development

# Database Configuration (PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/campuspulse?schema=public"

# Authentication & Security
JWT_SECRET="campuspulse-dev-secret-key-change-this-in-production-min32chars"
JWT_EXPIRES_IN="7d"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"

# AI Studio / External Integrations
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="http://localhost:3000"
